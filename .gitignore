# Python
__pycache__/
*.py[cod]
*.egg-info/
.env
data/raw_papers.json
data/analyzed_papers.json
data/features/*.json
!data/features/index.json
# Pipeline output. gh-pages is the store of record; the deploy workflows restore
# these from the published branch, so they must never be committed here.
data/weekly/

# Publish artifacts staged into web/public before `npm run build`. Regenerated by
# every deploy from gh-pages plus scripts/render_features.py. The tracked
# data/index.json and data/weekly/.gitkeep templates are deliberately kept.
web/public/data/weekly/*.json
web/public/data/features/
web/public/features/

# Node
node_modules/
web/dist/

# DevContainer
.devcontainer/.env
